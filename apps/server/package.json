{
  "name": "@repo/server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env/.env.dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node --env-file=.env/.env.prod dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"(server: no eslint configured)\" && exit 0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@repo/shared": "workspace:*",
    "amqplib": "^2.0.1",
    "better-auth": "^1.6.23",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.11.1",
    "mongodb": "^7.4.0",
    "mongoose": "^9.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
