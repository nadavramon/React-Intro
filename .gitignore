# Playwright (e2e) artifacts — unanchored so they match under apps/web/ (monorepo)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Claude Code — version the durable config, ignore personal/installed/noisy bits.
# Commit: CLAUDE.md, .mcp.json, .claude/commands, .claude/hooks, .claude/statusline.sh
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/statusline.sh
.playwright-mcp/

# Project docs (SDD specs/plans, assignments) stay local — not part of the shipped repo.
docs/
# Personal notes (any language variants)
docs/*-he.md

# Agent skills (installed via `npx skills`)
.agents/
skills-lock.json

